  <application android:name=".DriveApp" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:label="TG Drive" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:supportsRtl="false" android:usesCleartextTraffic="false" android:theme="@style/Theme.TGDrive" android:enableOnBackInvokedCallback="true">
